@page "/return"
@rendermode InteractiveServer
@using LibraryManagement.Components.Services
@inject LibraryService LibraryService

<h3>Return</h3>

<div class="mb-3">
    <label>Select User:</label>
    <select class="form-select" @bind="selectedUserId">
        <option value="0">-- SELECT A USER --</option>

        @foreach (var user in LibraryService.Users)
        {
            <option value="@user.Id">@user.Name</option>
        }
    </select>
</div>

<button class="btn btn-primary" @onclick="ShowBorrowedBooks">
    View Borrowed Books
</button>

<hr />

@if (showBooks)
{
    <h4>Borrowed Books</h4>
    @if (borrowedBooks.Count == 0)
    {
        <p>No borrowed books found for this user.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Title</th>
                    <th>Author</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var book in borrowedBooks)
                {
                    <tr>
                        <td>@book.Id</td>
                        <td>@book.Title</td>
                        <td>@book.Author</td>
                        <td>
                            <button class="btn btn-success btn-sm"
                            @onclick="() => ReturnBook(book.Id)">
                            RETURN
                        </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@if (!string.IsNullOrEmpty(message))
{
    <p class="mt-3">@message</p>
}
@code {
    private int selectedUserId = 0;
    private bool showBooks = false;
    private string message = "";

    private List<LibraryManagement.Components.Models.Book> borrowedBooks = new();

    private void ShowBorrowedBooks()
    {
        message = "";
        showBooks = true;
        borrowedBooks = LibraryService.GetBorrowedBooks(selectedUserId);
    }

    private void ReturnBook(int bookId)
    {
        bool success = LibraryService.ReturnBook(selectedUserId, bookId);

        if (success)
        {
            message = "Book returned successfully!";
            borrowedBooks = LibraryService.GetBorrowedBooks(selectedUserId).ToList();
        }
        else
        {
            message = "Unable to return book";
        }
    }

}
